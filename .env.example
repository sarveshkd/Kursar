# The app scores resumes with a local rubric. No key is required.
# To try the optional OpenAI adapter instead, set both variables:
# SCORER_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# Google Search Console gives you a verification code. Paste only the content value:
# GOOGLE_SITE_VERIFICATION=
#
# After AdSense approves the site, set the publisher id (it starts with ca-pub-):
# NEXT_PUBLIC_ADSENSE_CLIENT=
